# Country name (e.g. "Deutschland", "United States") or locale code (e.g. "de-de", "en-us").
# See README.md for the full list.
COUNTRY=de-de

# How often (in seconds) to poll the NVIDIA stock API. Minimum enforced: 5s.
REFRESH_INTERVAL_SECONDS=30

# Send a Telegram alert if the NVIDIA API becomes unreachable (true/false).
API_DOWN_ALARM_ENABLED=true

# Telegram Bot API URL, without text/parse_mode params. Leave empty to disable Telegram.
# Format: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
TELEGRAM_API_URL=

# Discord Webhook URL. Create one under a channel's Settings → Integrations → Webhooks. Leave empty to disable Discord.
# Format: https://discord.com/api/webhooks/<CHANNEL_ID>/<TOKEN>
DISCORD_WEBHOOK_URL=

# Comma-separated list of GPU models to monitor.
# Valid values: 5090,5080,5070,4090,4080S,4070S
GPU_MODELS=5080,5090

# Optional: URL of a live SKU feed (JSON, same shape as upstream's skus.json).
# Leave empty to use the static SKU table bundled with this service.
SKU_FEED_URL=

# Port for the /healthz endpoint.
PORT=8080
